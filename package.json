{
  "name": "skill-hub",
  "version": "0.9.13",
  "private": true,
  "description": "跨平台 SKILL 统一管理器（Windows / macOS）",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build --no-bundle && node scripts/make-portable.mjs",
    "portable": "npm run build",
    "build:mac": "tauri build --bundles app,dmg",
    "build:debug": "tauri build --debug --no-bundle",
    "icon": "tauri icon app-icon.png",
    "frontend": "python serve.py --no-open"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0"
  }
}
