{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skill Hub",
  "version": "0.9.6",
  "identifier": "com.skillhub.desktop",
  "build": {
    "beforeDevCommand": "node scripts/dev-server.mjs",
    "devUrl": "http://127.0.0.1:8765",
    "beforeBuildCommand": "node scripts/copy-frontend.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Skill Hub",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "跨平台 SKILL 统一管理器",
    "longDescription": "把 Claude Code、Codex、WorkBuddy、Trae 等 Agent 的 SKILL 聚合到一个界面，支持分类浏览、内容预览、导入导出、安装状态与一键同步。",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
